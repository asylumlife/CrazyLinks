{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crazylinks.dev/schemas/page.v1.json",
  "title": "CrazyLinks page document, schema v1",
  "description": "Canonical page JSON stored in post_content of crazylinks_page posts. Flat block list (parent_id, max depth 1), non-recursive, additionalProperties false throughout.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "design",
    "blocks",
    "settings"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "blocks": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "settings": {
      "$ref": "#/$defs/settings"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "color_or_empty": {
      "type": "string",
      "pattern": "^(?:|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
    },
    "datetime_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "solid",
            "gradient",
            "image",
            "pattern"
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "from": {
          "$ref": "#/$defs/color"
        },
        "to": {
          "$ref": "#/$defs/color"
        },
        "angle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 360
        },
        "radial": {
          "type": "boolean"
        },
        "image": {
          "type": "integer",
          "minimum": 0
        },
        "overlay": {
          "$ref": "#/$defs/color_or_empty"
        },
        "blur": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "pattern": {
          "type": "string",
          "enum": [
            "dots",
            "grid",
            "stripes",
            "lines",
            "checks",
            "noise"
          ]
        },
        "pattern_color": {
          "$ref": "#/$defs/color"
        },
        "pattern_size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 80
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "maxLength": 280
        },
        "avatar": {
          "type": "integer",
          "minimum": 0
        },
        "avatar_style": {
          "type": "string",
          "enum": [
            "circle",
            "square",
            "hero",
            "banner",
            "shape"
          ]
        },
        "shape_mask": {
          "type": "string",
          "enum": [
            "circle",
            "squircle",
            "blob"
          ]
        },
        "banner": {
          "type": "integer",
          "minimum": 0
        },
        "location": {
          "type": "string",
          "maxLength": 80
        },
        "pronouns": {
          "type": "string",
          "maxLength": 40
        },
        "verified_badge": {
          "type": "boolean"
        },
        "header_layout": {
          "type": "string",
          "enum": [
            "centered",
            "left",
            "hero",
            "banner"
          ]
        },
        "banner_focal_point": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "description": "Page header. Rendered first; there is no separate profile block."
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9-]*$"
        },
        "background": {
          "$ref": "#/$defs/background"
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            },
            "muted": {
              "$ref": "#/$defs/color"
            },
            "font": {
              "type": "string",
              "enum": [
                "system-sans",
                "system-serif",
                "system-rounded",
                "system-mono"
              ]
            },
            "size": {
              "type": "string",
              "enum": [
                "sm",
                "md",
                "lg"
              ]
            }
          }
        },
        "button": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "pill",
                "rounded",
                "square"
              ]
            },
            "fill": {
              "type": "string",
              "enum": [
                "solid",
                "outline",
                "soft",
                "glass"
              ]
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "text_color": {
              "$ref": "#/$defs/color"
            },
            "shadow": {
              "type": "string",
              "enum": [
                "none",
                "soft",
                "hard"
              ]
            },
            "border_width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "hover": {
              "type": "string",
              "enum": [
                "lift",
                "darken",
                "none"
              ]
            }
          }
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "layout": {
          "type": "string",
          "enum": [
            "list",
            "grid",
            "featured"
          ]
        },
        "dark_mode": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        },
        "custom_css": {
          "type": "string",
          "maxLength": 20000,
          "description": "Requires unfiltered_html to change."
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "render_mode": {
          "type": "string",
          "enum": [
            "default",
            "standalone",
            "theme"
          ]
        },
        "in_app_hint": {
          "type": "boolean"
        },
        "utm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "maxLength": 64
            },
            "medium": {
              "type": "string",
              "maxLength": 64
            },
            "campaign": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "description": {
              "type": "string",
              "maxLength": 320
            },
            "image": {
              "type": "integer",
              "minimum": 0
            },
            "noindex": {
              "type": "boolean"
            }
          }
        },
        "footer_credit": {
          "type": "boolean",
          "description": "Prints a small \"Made with CrazyLinks\" line under the page. Off by default."
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/datetime_or_null"
        },
        "end": {
          "$ref": "#/$defs/datetime_or_null"
        },
        "weekly": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "days",
            "start",
            "end"
          ],
          "description": "Recurring weekly window in the site timezone. days are ISO weekdays (1 = Monday ... 7 = Sunday); start and end are HH:MM (24-hour). A window belongs to the day it starts on; an end at or before the start runs past midnight into the next day. Both this window and the one-off start/end must be satisfied when both are set.",
          "properties": {
            "days": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              }
            },
            "start": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "parent_id",
        "order",
        "visible",
        "schedule",
        "pinned",
        "animation",
        "tracking",
        "props"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "type": {
          "type": "string",
          "enum": [
            "link",
            "socials",
            "heading",
            "text",
            "divider",
            "image",
            "gallery",
            "latest_posts",
            "product",
            "embed",
            "video",
            "email_capture",
            "contact",
            "group",
            "woo_products",
            "payment",
            "html",
            "spacer",
            "countdown",
            "map"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "visible": {
          "type": "boolean"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "pinned": {
          "type": "boolean"
        },
        "animation": {
          "type": "string",
          "enum": [
            "none",
            "pulse",
            "shake",
            "wobble",
            "shimmer"
          ]
        },
        "tracking": {
          "type": "boolean"
        },
        "props": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_link"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "socials"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_socials"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_heading"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_text"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "divider"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_divider"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_image"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "gallery"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_gallery"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "latest_posts"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_latest_posts"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "product"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_product"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "embed"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_embed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "video"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_video"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "email_capture"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_email_capture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "contact"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_contact"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_group"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "woo_products"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_woo_products"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "payment"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_payment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "html"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_html"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "spacer"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_spacer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "countdown"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_countdown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "map"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/props_map"
              }
            }
          }
        }
      ]
    },
    "props_link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "description": "Scheme must be http, https, mailto, tel or sms (enforced by the PHP URL policy).",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "maxLength": 160
        },
        "display": {
          "type": "string",
          "enum": [
            "classic",
            "featured",
            "thumbnail"
          ]
        },
        "thumbnail": {
          "type": "integer",
          "minimum": 0
        },
        "icon": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-z0-9-]*$"
        },
        "emoji": {
          "type": "string",
          "maxLength": 16
        },
        "focal_point": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "badge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 24
            },
            "color": {
              "$ref": "#/$defs/color_or_empty"
            }
          }
        },
        "tile_size": {
          "type": "string",
          "enum": [
            "1x1",
            "2x1",
            "2x2"
          ]
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fill": {
              "type": "string",
              "enum": [
                "solid",
                "outline",
                "soft",
                "glass"
              ]
            },
            "color": {
              "$ref": "#/$defs/color_or_empty"
            },
            "text_color": {
              "$ref": "#/$defs/color_or_empty"
            }
          }
        },
        "open_new_tab": {
          "type": "boolean"
        },
        "rel": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "nofollow",
              "sponsored"
            ]
          }
        },
        "deep_link": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional app URL scheme. Stored only in Phase 1."
        },
        "thumb_side": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "new_until": {
          "type": "string",
          "format": "date-time",
          "description": "Shows a NEW flag until this time."
        },
        "thumbnail_alt": {
          "type": "string",
          "maxLength": 250,
          "description": "Alternative text for the thumbnail or featured image. Falls back to the Media Library alt text."
        },
        "decorative": {
          "type": "boolean",
          "description": "The thumbnail is decorative: renders with empty alt text and silences the missing-alt warning."
        }
      },
      "required": [
        "title",
        "url"
      ]
    },
    "props_socials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "network": {
                "type": "string",
                "enum": [
                  "instagram",
                  "tiktok",
                  "youtube",
                  "x",
                  "twitter",
                  "facebook",
                  "threads",
                  "bluesky",
                  "mastodon",
                  "linkedin",
                  "pinterest",
                  "snapchat",
                  "twitch",
                  "discord",
                  "whatsapp",
                  "telegram",
                  "signal",
                  "spotify",
                  "apple_music",
                  "soundcloud",
                  "bandcamp",
                  "github",
                  "dribbble",
                  "behance",
                  "medium",
                  "substack",
                  "patreon",
                  "kofi",
                  "reddit",
                  "tumblr",
                  "vimeo",
                  "etsy",
                  "amazon",
                  "email",
                  "phone",
                  "website",
                  "rss"
                ]
              },
              "url": {
                "type": "string",
                "maxLength": 2048,
                "description": "Scheme must be http, https, mailto, tel or sms (enforced by the PHP URL policy).",
                "minLength": 1
              },
              "id": {
                "$ref": "#/$defs/ulid",
                "description": "Stable item id; generated by the validator when missing. Used in /go/{block_id}/{item_id}/ click URLs."
              }
            },
            "required": [
              "network",
              "url"
            ]
          }
        },
        "style": {
          "type": "string",
          "enum": [
            "icons",
            "buttons"
          ]
        }
      },
      "required": [
        "items"
      ]
    },
    "props_heading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "level": {
          "type": "string",
          "enum": [
            "h2",
            "h3"
          ]
        },
        "align": {
          "type": "string",
