{
  "name": "crazylinks",
  "version": "0.3.0",
  "private": true,
  "description": "CrazyLinks admin page editor (React).",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build assets/src/editor/index.tsx --output-path=assets/build/editor",
    "start": "wp-scripts start assets/src/editor/index.tsx --output-path=assets/build/editor",
    "lint:js": "wp-scripts lint-js assets/src/editor tests/js tests/e2e",
    "lint:css": "wp-scripts lint-style \"assets/src/editor/**/*.scss\"",
    "test:unit": "wp-scripts test-unit-js run --config tests/js/vitest.config.mts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@wordpress/scripts": "37.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@wordpress/api-fetch": "8.1.0",
    "@wordpress/components": "44.0.0",
    "@wordpress/compose": "9.1.0",
    "@wordpress/data": "11.1.0",
    "@wordpress/dom-ready": "5.1.0",
    "@wordpress/element": "10.1.0",
    "@wordpress/i18n": "7.1.0",
    "@wordpress/icons": "20.0.0"
  },
  "overrides": {
    "serialize-javascript": "7.1.3",
    "minimatch@>=7 <11.0.1": "11.0.1",
    "js-yaml@5": "5.4.1",
    "katex": "0.18.2",
    "smol-toml": "1.9.0"
  }
}
